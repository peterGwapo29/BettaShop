# Uploaded files are customer photos only — this directory should never
# execute PHP, even if a malicious file ever slipped past validation.
# Covers both Apache 2.2 and 2.4 syntax.

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php[0-9]|phar|pl|py|cgi|asp|aspx)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
